#!/usr/bin/env bash
#
# reference-transaction hook: master may only move to a commit that has
# passed `nix flake check`.
#
# Other branches are not gated (see "Testing policy" in AGENTS.md). Hooking
# the ref update rather than `pre-commit` also covers fast-forward merges,
# resets and rebases, which never run `pre-commit`.
#
# How it works:
#   1. In the "prepared" phase, finds updates to refs/heads/master
#   2. Evaluates nix to get the check derivation paths for the new commit
#   3. Uses nix-store --realise --dry-run to check if all outputs are
#      available (locally or via substituter)
#
# If any check output needs to be built, the ref update is rejected.

set -euo pipefail

[[ $1 == prepared ]] || exit 0

COMMITS=()
while read -r _old new ref; do
  # Deleting master (all-zero new value) is not gated.
  if [[ $ref == refs/heads/master && ! $new =~ ^0+$ ]]; then
    COMMITS+=("$new")
  fi
done

for COMMIT in ${COMMITS[@]+"${COMMITS[@]}"}; do
  SYSTEM=$(nix eval --raw --impure --expr 'builtins.currentSystem')

  # Evaluate derivation paths (no building, just evaluation ~2s)
  DRVS=$(nix eval ".?rev=$COMMIT#checks.$SYSTEM" \
    --apply 'builtins.mapAttrs (_: c: c.drvPath)' --json 2>/dev/null) || {
    echo "error: could not evaluate flake checks for $COMMIT"
    exit 1
  }

  DRV_PATHS=()
  while IFS= read -r path; do
    DRV_PATHS+=("$path")
  done < <(echo "$DRVS" | jq -r '.[]')

  if [[ ${#DRV_PATHS[@]} -eq 0 ]]; then
    echo "error: no flake checks found"
    exit 1
  fi

  # nix-store --realise --dry-run checks availability without building:
  #   - paths in local store: no output
  #   - paths on a substituter: "will be fetched"
  #   - paths not built anywhere: "will be built" (drv paths in output)
  DRY_OUTPUT=$(nix-store --realise --dry-run "${DRV_PATHS[@]}" 2>&1)

  # .drv paths in the output indicate derivations that need building
  NEEDS_BUILD=$(echo "$DRY_OUTPUT" | grep '\.drv$' || true)
  if [[ -n "$NEEDS_BUILD" ]]; then
    echo "nix flake check has not passed for $COMMIT."
    echo "master may only point to commits that pass nix flake check."
    echo ""
    echo "Run this now:"
    echo "  nix --option keep-going true flake check '.?rev=$COMMIT'"
    echo "and retry once it succeeds."
    echo ""
    echo "DO NOT BYPASS THIS CHECK."
    echo ""
    TOTAL=$(echo "$NEEDS_BUILD" | wc -l)
    if [[ $TOTAL -gt 10 ]]; then
      echo "Derivations that need building (showing 10 of $TOTAL):"
      echo "$NEEDS_BUILD" | sed -n 1,10p | sed 's/^/  /'
    else
      echo "Derivations that need building:"
      echo "$NEEDS_BUILD" | sed 's/^/  /'
    fi
    exit 1
  fi
done
